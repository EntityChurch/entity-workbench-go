# ===========================================================
# avalonia — multi-stage build for the Avalonia desktop renderer
#
# Build context expectation: the parent of entity-workbench-go,
# so both `entity-core-go/` and `entity-workbench-go/` are visible.
# The Makefile handles invoking podman with the right context.
# ===========================================================

# -----------------------------------------------------------
# Stage 1: build the Go c-shared bridge + Avalonia frontend
# -----------------------------------------------------------
FROM fedora:43 AS builder

# Headless UI tests now run real Skia paint (UseHeadlessDrawing=false
# in TestAppBuilder), so the builder image also needs libSkiaSharp's
# native dependencies — fontconfig + freetype + harfbuzz + libpng.
# Without these, the test process throws "Unable to load shared
# library 'libSkiaSharp'" on first Window.Show().
RUN dnf install -y \
        golang \
        gcc \
        glibc-devel \
        dotnet-sdk-8.0 \
        fontconfig \
        freetype \
        harfbuzz \
        libpng \
        libicu \
    && dnf clean all

# BUILD STAMP — the answer to "which build is this machine running?"
#
# Two machines running different builds, with no way to tell them apart,
# cost a full day on 2026-09-03: a fix was "reproduced" as still broken
# against a binary that predated it. The stamp is derived by the Makefile
# from git describe PLUS a hash of the working-tree diff, so it is stable
# for an unchanged tree (the layer cache still hits on a no-op rebuild)
# and distinct for any edit, committed or not.
#
# It is baked into BOTH artifacts. They are always built together here, so
# a disagreement between them at runtime means dist-native/ has a stale
# libbridge.so beside a fresh frontend — which `extract` can produce and
# nothing else would report.
ARG BUILD_STAMP=unknown

# Both siblings into /src
COPY entity-core-go         /src/entity-core-go
COPY entity-workbench-go    /src/entity-workbench-go

# ---- Go c-shared bridge ------------------------------------
# Symbols kept (no -s -w). When the app crashes, `make crash`
# uses addr2line against this library to decode coredump
# addresses to Go function names — we can't diagnose without it,
# and the size cost is ~3-4MB which we don't care about.
#
# CACHE MOUNTS, on every compile step in this file. Before them, the two
# COPY lines above invalidated everything below on any source edit, so
# every build re-downloaded the whole Go module graph and the whole NuGet
# graph — including the self-contained linux-x64 runtime packs — and
# recompiled from cold. A cache mount is not part of the image, so it
# survives that invalidation: the module and NuGet caches persist, and so
# does the Go build cache, which is the larger win (incremental compile
# rather than incremental download).
WORKDIR /src/entity-workbench-go/avalonia/bridge
RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 \
    go build -buildmode=c-shared \
        -ldflags "-X main.buildStamp=${BUILD_STAMP}" \
        -o /build/libbridge.so .

# ---- libaltstack.so: the sigaltstack interposer ------------
#
# LD_PRELOAD'd by run-with-dump.sh so EVERY thread gets an alternate
# signal stack large enough for CoreCLR's handler chain on an AVX-512
# host. See altstack-preload.c for the two coredumps that measured the
# need; the short version is that the PAL gives each thread 12 KiB of
# usable alt stack, the handler chain needs 13,088 bytes on this
# hardware, and the 800-byte overrun is an unrecoverable process kill.
#
# CrashDiagnostics can only reach the UI thread and the render thread —
# sigaltstack must be called ON the thread it covers, and no managed
# hook runs on a fresh thread-pool, finalizer or timer thread. Sixteen
# threads were still on the stock size when the crash was measured.
#
# Built here rather than vendored so it always matches the image's glibc.
RUN gcc -shared -fPIC -O2 -Wall -Wextra \
        -o /build/libaltstack.so \
        /src/entity-workbench-go/avalonia/altstack-preload.c \
        -ldl -lpthread

# ---- Avalonia self-contained publish -----------------------
WORKDIR /src/entity-workbench-go/avalonia/frontend
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish -c Release -r linux-x64 --self-contained true \
        -p:PublishSingleFile=false \
        -p:InformationalVersion=${BUILD_STAMP} \
        -o /build/dist

# Drop the bridge into the .NET runtime directory so the loader
# finds it adjacent to the host executable. Same for the alt-stack
# interposer, which run-with-dump.sh names by relative path.
RUN cp /build/libbridge.so /build/libaltstack.so /build/dist/

# Install dotnet-dump for managed crash analysis. Ship it inside
# /build/dist so `make crash` on the host can run it via the
# self-contained .NET runtime included in the dist. Without this
# the host (which has no .NET SDK) can't decode managed minidumps.
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet tool install --tool-path /build/dist/tools dotnet-dump

# -----------------------------------------------------------
# Stage 1.5: headless UI tests
#
# Reuses the builder's SDK + already-built libbridge.so. Runs
# Avalonia.Headless.XUnit tests against a real bridge-backed peer
# (no mocks). Failures here fail the build, so `podman build
# --target tester` is the make test-avalonia entry point.
#
# LD_LIBRARY_PATH=/build so the test process's DllImport("bridge")
# finds the just-built libbridge.so adjacent to the test binary
# in /build.
# -----------------------------------------------------------
FROM builder AS tester
WORKDIR /src/entity-workbench-go/avalonia/tests/Workbench.Headless.Tests
ENV LD_LIBRARY_PATH=/build
# The test process runs under the same alt-stack interposer the app does,
# so AltStackCoverageTests measures the shipped configuration rather than
# a second one that only the suite ever sees. Its control arm is in
# run-xvfb-smoke.sh, where WB_ALTSTACK_BYTES=0 can be set per run.
ENV LD_PRELOAD=/build/libaltstack.so
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet test -c Release --logger "console;verbosity=normal"

# -----------------------------------------------------------
# Stage 2: runtime image (minimal X11/GL stack for Avalonia)
# -----------------------------------------------------------
FROM fedora:43

RUN dnf install -y \
        libicu \
        fontconfig \
        freetype \
        libX11 \
        libXi \
        libXcursor \
        libXrandr \
        libXinerama \
        libxkbcommon \
        libGL \
        mesa-dri-drivers \
        xorg-x11-server-Xvfb \
        openbox \
        ImageMagick \
        xdotool \
        gdb \
    && dnf clean all

WORKDIR /app
COPY --from=builder /build/dist/ ./

ENV LD_LIBRARY_PATH=/app
# DOTNET_EnableDiagnostics=1 is the default — leaving the previous
# explicit `=0` in place silenced every managed exception + stack
# trace at process exit, which is what kept us guessing through
# four segfaults. Make sure it stays enabled.
ENV DOTNET_EnableDiagnostics=1

CMD ["./entity-avalonia"]
